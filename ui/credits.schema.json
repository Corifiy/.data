{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Credits",
	"description": "Credits shown in game. Sections are drawn in array order, and members in array order within each section.",
	"type": "object",
	"required": ["version", "sections"],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"version": {
			"description": "Format version. Builds ignore a file whose version they do not understand.",
			"const": 1
		},
		"sections": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/section" }
		}
	},
	"$defs": {
		"section": {
			"type": "object",
			"required": ["id", "title", "members"],
			"additionalProperties": false,
			"properties": {
				"id": {
					"description": "Stable identifier for code to key off. Renaming the title never changes it.",
					"type": "string",
					"pattern": "^[a-z][A-Za-z0-9]*$"
				},
				"title": {
					"description": "Heading shown above the section.",
					"type": "string",
					"minLength": 1
				},
				"order": {
					"description": "How the members are ordered. Only documents the order; the array order is what is shown.",
					"enum": ["joinDate"]
				},
				"members": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/member" }
				}
			}
		},
		"member": {
			"type": "object",
			"required": ["name"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"description": "Name as shown in game.",
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
